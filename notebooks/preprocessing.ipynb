    "# ============================================================\n",
    "# LOAD DATA FROM POSTGRESQL WAREHOUSE\n",
    "# ============================================================\n",
    "\n",
    "# Database Configuration\n",
    "DB_TYPE = 'postgresql'\n",
    "DB_USER = 'root'\n",
    "DB_PASSWORD = 'root'\n",
    "DB_HOST = 'localhost'\n",
    "DB_PORT = 5432\n",
    "DB_NAME = 'fraud_detection_dw'\n",
    "\n",
    "# Create connection\n",
    "connection_string = f\"postgresql://{DB_USER}:{DB_PASSWORD}@{DB_HOST}:{DB_PORT}/{DB_NAME}\"\n",
    "\n",
    "try:\n",
    "    engine = create_engine(connection_string, echo=False)\n",
    "    # Test connection\n",
    "    with engine.connect() as conn:\n",
    "        result = conn.execute(text(\"SELECT 1\"))\n",
    "    print(f\"✓ Database connection successful: {DB_NAME}\")\n",
    "except Exception as e:\n",
    "    print(f\"✗ Database connection failed: {e}\")\n",
    "    raise\n",
    "\n",
    "# Load from warehouse fact table with all dimension data\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"LOADING DATA FROM WAREHOUSE (fraud_detection_dw)\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "query = \"\"\"\n",
    "SELECT \n",
    "    ft.trans_num,\n",
    "    dt.trans_date_trans_time,\n",
    "    dc.cc_num,\n",
    "    dc.first_name,\n",
    "    dc.last_name,\n",
    "    dc.gender,\n",
    "    dc.dob,\n",
    "    dc.job,\n",
    "    dc.street,\n",
    "    dc.city,\n",
    "    dc.state,\n",
    "    dc.zip,\n",
    "    dc.lat,\n",
    "    dc.long,\n",
    "    dm.merchant_name as merchant,\n",
    "    dm.merchant_category as category,\n",
    "    dm.merch_lat,\n",
    "    dm.merch_long,\n",
    "    dl.city_pop,\n",
    "    dt.hour,\n",
    "    dt.day_of_week,\n",
    "    dt.day_of_week_name,\n",
    "    dt.month,\n",
    "    dt.month_name,\n",
    "    dt.year,\n",
    "    dt.is_weekend,\n",
    "    ft.amount as amt,\n",
    "    ft.is_fraud,\n",
    "    ft.data_split\n",
    "FROM fact_transactions ft\n",
    "JOIN dim_customer dc ON ft.customer_id = dc.customer_id\n",
    "JOIN dim_merchant dm ON ft.merchant_id = dm.merchant_id\n",
    "JOIN dim_location dl ON ft.location_id = dl.location_id\n",
    "JOIN dim_time dt ON ft.time_id = dt.time_id\n",
    "ORDER BY dt.trans_date_trans_time\n",
    "\"\"\"\n",
    "\n",
    "try:\n",
    "    combined_df = pd.read_sql(query, engine)\n",
    "    print(f\"✓ Loaded {len(combined_df):,} rows from warehouse\")\n",
    "except Exception as e:\n",
    "    print(f\"✗ Error loading data: {e}\")\n",
    "    raise\n",
    "\n",
    "# Split by data_split column (train vs test)\n",
    "train_df = combined_df[combined_df['data_split'] == 'train'].copy()\n",
    "test_df = combined_df[combined_df['data_split'] == 'test'].copy()\n",
    "\n",
    "if SAMPLE_FRAC is not None:\n",
    "    train_df = train_df.sample(frac=SAMPLE_FRAC, random_state=RANDOM_STATE)\n",
    "    test_df = test_df.sample(frac=SAMPLE_FRAC, random_state=RANDOM_STATE)\n",
    "\n",
    "print(f\"\\n✓ Data split from warehouse:\")\n",
    "print(f\"  - Train data: {train_df.shape[0]:,} rows\")\n",
    "print(f\"  - Test data: {test_df.shape[0]:,} rows\")\n",
    "print(f\"  - Total columns: {train_df.shape[1]}\")\n"
